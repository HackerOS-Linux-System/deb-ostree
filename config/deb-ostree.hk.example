! /etc/deb-ostree/deb-ostree.hk
! Konfiguracja narzędzia deb-ostree w formacie .hk
! (https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html)
!
! Ten plik jest generowany automatycznie przez hackeros-builder podczas
! budowy obrazu (patrz hackeros-builder/internal/hkgen), ale możesz go
! też edytować ręcznie na żywym systemie.

[sysroot]
! Ścieżka do sysroot zarządzanego przez deb-ostree (zwykle "/")
-> path => /

[ostree]
! Ścieżka do repo OSTree wewnątrz sysroot
-> repo_path => /ostree/repo

[system]
! Nazwa "osname" używana przy tworzeniu deploymentów w /ostree/deploy/<osname>/
-> osname => debian

[overlay]
! Katalog roboczy używany przez overlayfs przy instalacji/usuwaniu pakietów.
! Powinien być na tym samym filesystemie co /ostree (dla efektywnych
! hardlinków/reflinkow podczas checkout), z wystarczającą ilością wolnego miejsca.
-> work_dir => /var/lib/deb-ostree/overlay-work

[apt]
! Cache list pakietów apt (niezależny od /var/lib/apt na żywym systemie)
-> lists_path => /var/lib/deb-ostree/apt-cache

! Źródła pakietów -- odpowiednik /etc/apt/sources.list
! Format: source_N => deb <url> <suite> <component...>
! N musi być ciągłe od 1 (pierwsza luka kończy parsowanie)
-> source_1 => deb http://deb.debian.org/debian bookworm main contrib non-free
-> source_2 => deb http://security.debian.org/debian-security bookworm-security main contrib
-> source_3 => deb http://deb.debian.org/debian bookworm-updates main contrib

[origin]
! Refspec obrazu OCI uznawany za "origin" tego deploymentu.
! Ustawiany automatycznie przez "deb-ostree deploy/rebase", albo ręcznie
! tutaj przy pierwszym bootstrapie (np. przez hackeros-builder).
-> refspec => deb-ostree-oci:ghcr.io/przyklad/obraz:bookworm
