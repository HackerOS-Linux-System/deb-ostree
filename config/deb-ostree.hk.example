! /etc/deb-ostree/deb-ostree.hk
! Konfiguracja deb-ostree w formacie .hk (komentarze zaczynaja sie od '!')
!
! deb-ostree NIE wymaga zainstalowanego apt ani dpkg.
! Uzywa tych samych plikow i sciezek co apt/dpkg:
!   /etc/apt/sources.list      -- zrodla pakietow (czytane automatycznie)
!   /var/lib/apt/lists/        -- cache indeksow Packages
!   /var/lib/dpkg/status       -- baza zainstalowanych pakietow
!   /var/lib/dpkg/info/        -- skrypty maintainer i listy plikow
!   /etc/apt/trusted.gpg.d/    -- klucze GPG
!
! Minimalna konfiguracja dla systemu z /etc/apt/sources.list:
! (tylko sekcje [sysroot], [ostree], [system] i [overlay] sa wymagane)

[sysroot]
! Sciezka do sysroot (zwykle "/" na zywo systemie)
-> path => /

[ostree]
! Sciezka do repo OSTree wewnatrz sysroot
-> repo_path => /ostree/repo

[system]
! Nazwa "osname" w /ostree/deploy/<osname>/
-> osname => debian

[overlay]
! Katalog roboczy transakcji deb-ostree
! JEDYNA wlasna sciezka -- wszystko inne jest kompatybilne z apt/dpkg
-> work_dir => /var/lib/deb-ostree/overlay-work

[origin]
! Refspec obrazu OCI -- ustawiany automatycznie przez deploy/rebase
! -> refspec => deb-ostree-oci:ghcr.io/mojorg/debian-bootc:bookworm

! === OPCJONALNE: nadpisanie sciezek apt (domyslnie sa identyczne z apt) ===

! [apt]
! -> sources_list  => /etc/apt/sources.list
! -> sources_dir   => /etc/apt/sources.list.d
! -> lists_path    => /var/lib/apt/lists
! -> keyring_dir   => /etc/apt/trusted.gpg.d
! -> arch          => amd64
! -> confext_mode  => none

! === FALLBACK: zrodla apt dla srodowisk bez /etc/apt/sources.list ===
! (np. builder/CI gdzie apt nie jest zainstalowany)
! Odkomentuj ponizsze jezeli deb-ostree dziala poza systemem Debian:

! [apt]
! -> source_1 => deb http://deb.debian.org/debian bookworm main contrib non-free
! -> source_2 => deb http://security.debian.org/debian-security bookworm-security main
! -> source_3 => deb http://deb.debian.org/debian bookworm-updates main
